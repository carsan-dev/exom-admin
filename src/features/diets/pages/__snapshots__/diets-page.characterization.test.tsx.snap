<label class="font-normal text-foreground-secondary peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-xs" for="ID-form-item">Kcal</label>
<input class="flex w-full max-md:h-11 rounded-md border border-input bg-input px-3 py-2 text-foreground transition-[border-color,background-color] duration-(--dur-fast) ease-(--ease-out) file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground hover:border-control-border-hover focus-visible:border-focus focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-focus aria-invalid:border-status-error read-only:bg-transparent disabled:cursor-not-allowed disabled:border-border disabled:bg-transparent disabled:text-muted-foreground disabled:hover:border-border h-8 text-xs" min="0" placeholder="500" id="ID-form-item" aria-invalid="false" type="number" value="400">
</div>
<div class="space-y-2">
<label class="font-normal text-foreground-secondary peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-xs" for="ID-form-item">Proteína (g)</label>
<input class="flex w-full max-md:h-11 rounded-md border border-input bg-input px-3 py-2 text-foreground transition-[border-color,background-color] duration-(--dur-fast) ease-(--ease-out) file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground hover:border-control-border-hover focus-visible:border-focus focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-focus aria-invalid:border-status-error read-only:bg-transparent disabled:cursor-not-allowed disabled:border-border disabled:bg-transparent disabled:text-muted-foreground disabled:hover:border-border h-8 text-xs" min="0" step="0.1" placeholder="40" id="ID-form-item" aria-invalid="false" type="number" value="20">
</div>
<div class="space-y-2">
<label class="font-normal text-foreground-secondary peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-xs" for="ID-form-item">Carbos (g)</label>
<input class="flex w-full max-md:h-11 rounded-md border border-input bg-input px-3 py-2 text-foreground transition-[border-color,background-color] duration-(--dur-fast) ease-(--ease-out) file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground hover:border-control-border-hover focus-visible:border-focus focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-focus aria-invalid:border-status-error read-only:bg-transparent disabled:cursor-not-allowed disabled:border-border disabled:bg-transparent disabled:text-muted-foreground disabled:hover:border-border h-8 text-xs" min="0" step="0.1" placeholder="60" id="ID-form-item" aria-invalid="false" type="number" value="50">
</div>
<div class="space-y-2">
<label class="font-normal text-foreground-secondary peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-xs" for="ID-form-item">Grasa (g)</label>
<input class="flex w-full max-md:h-11 rounded-md border border-input bg-input px-3 py-2 text-foreground transition-[border-color,background-color] duration-(--dur-fast) ease-(--ease-out) file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground hover:border-control-border-hover focus-visible:border-focus focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-focus aria-invalid:border-status-error read-only:bg-transparent disabled:cursor-not-allowed disabled:border-border disabled:bg-transparent disabled:text-muted-foreground disabled:hover:border-border h-8 text-xs" min="0" step="0.1" placeholder="20" id="ID-form-item" aria-invalid="false" type="number" value="10">
</div>
</div>
<div role="group" aria-label="Suma de ingredientes de la comida 1" class="min-w-0 space-y-2 border border-border bg-background-surface p-3">
<div class="flex flex-wrap items-center justify-between gap-2">
<p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-foreground-muted">Suma de ingredientes</p>
<span class="inline-flex h-[22px] items-center gap-1.5 whitespace-nowrap rounded-full px-2 text-xs font-semibold leading-none bg-status-warning-soft text-status-warning">
<span aria-hidden="true" data-slot="status-chip-dot" class="size-1.5 flex-none rounded-full bg-current">
</span>No cuadra</span>
</div>
<table class="w-full table-fixed text-xs tabular-nums">
<thead>
<tr class="text-foreground-muted">
<th scope="col" class="w-[22%] pb-1 text-left font-normal">
<span class="sr-only">Macro</span>
</th>
<th scope="col" class="pb-1 text-right font-normal">Ingredientes</th>
<th scope="col" class="pb-1 text-right font-normal">Declarado</th>
<th scope="col" class="pb-1 text-right font-normal">Diferencia</th>
</tr>
</thead>
<tbody>
<tr>
<th scope="row" class="py-0.5 text-left font-medium text-foreground-secondary">Kcal</th>
<td class="py-0.5 text-right text-foreground">304 kcal</td>
<td class="py-0.5 text-right text-foreground-secondary">400 kcal</td>
<td class="py-0.5 text-right font-semibold text-status-warning">−96 kcal</td>
</tr>
<tr>
<th scope="row" class="py-0.5 text-left font-medium text-foreground-secondary">Proteína</th>
<td class="py-0.5 text-right text-foreground">10.4 g</td>
<td class="py-0.5 text-right text-foreground-secondary">20 g</td>
<td class="py-0.5 text-right font-semibold text-status-warning">−9.6 g</td>
</tr>
<tr>
<th scope="row" class="py-0.5 text-left font-medium text-foreground-secondary">Carbos</th>
<td class="py-0.5 text-right text-foreground">52.8 g</td>
<td class="py-0.5 text-right text-foreground-secondary">50 g</td>
<td class="py-0.5 text-right font-semibold text-status-warning">+2.8 g</td>
</tr>
<tr>
<th scope="row" class="py-0.5 text-left font-medium text-foreground-secondary">Grasa</th>
<td class="py-0.5 text-right text-foreground">5.6 g</td>
<td class="py-0.5 text-right text-foreground-secondary">10 g</td>
<td class="py-0.5 text-right font-semibold text-status-warning">−4.4 g</td>
</tr>
</tbody>
</table>
<p class="text-[11px] leading-4 text-foreground-muted">No suma 1 ingrediente sin datos en el catálogo o sin gramos.</p>
</div>
</div>
<div class="space-y-2">
<div class="space-y-2">
<p class="text-sm font-medium leading-none">Imagen de la comida</p>
<button type="button" class="flex w-full cursor-pointer flex-col items-center gap-2 rounded-lg border border-dashed border-border/70 bg-muted/30 px-4 py-5 text-center transition-colors hover:border-brand-primary/50 hover:bg-brand-soft/5 disabled:cursor-not-allowed disabled:opacity-50">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-upload h-6 w-6 text-muted-foreground" aria-hidden="true">
<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4">
</path>
<polyline points="17 8 12 3 7 8">
</polyline>
<line x1="12" x2="12" y1="3" y2="15">
</line>
</svg>
<div class="space-y-1">
<p class="text-sm font-medium text-foreground">Seleccionar imagen</p>
<p class="text-xs text-muted-foreground">JPG, PNG o WebP · Máx. 10 MB (se comprime automáticamente)</p>
</div>
</button>
<input accept="image/jpeg,image/png,image/webp" class="hidden" type="file">
</div>
</div>
<div class="space-y-2">
<label class="font-normal text-foreground-secondary peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-xs" for="ID-form-item">Badges nutricionales (opcional)</label>
<div class="space-y-2">
