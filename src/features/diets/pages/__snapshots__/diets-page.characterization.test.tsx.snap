        { "ingredient_name": "Pavo", "quantity": 4, "unit": "cold_cut_slice", "grams_equivalent": 80 }
      ]
    }
  ]
}</code>
</pre>
</div>
<div class="space-y-2">
<p class="text-sm font-semibold text-foreground">Gramos y medida casera</p>
